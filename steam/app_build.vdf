"AppBuild"
{
	// Замените 1000000 на AppID игры, а 1000001–1000003 — на ID депо из Steamworks
	"AppID" "1000000"
	"Desc" "25 Waves 1.0.0"
	// Папка со сборками (результат npm run dist:win / dist:mac / dist:linux или артефакты CI)
	"ContentRoot" "../desktop/release/"
	"BuildOutput" "./output/"
	// Ветка для автоматической публикации сборки (пусто — публикация вручную в Steamworks)
	"SetLive" ""
	"Depots"
	{
		"1000001" "depot_windows.vdf"
		"1000002" "depot_macos.vdf"
		"1000003" "depot_linux.vdf"
	}
}
